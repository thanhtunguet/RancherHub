FROM golang:1.26-alpine AS builder
WORKDIR /src

RUN apk add --no-cache build-base ca-certificates

COPY apps/backend/go.mod apps/backend/go.sum ./
RUN go mod download

COPY apps/backend ./
RUN CGO_CFLAGS="-O0" go build -tags=nomsgpack -o /out/rancher-hub-backend ./cmd/server

FROM alpine:3.21 AS production
WORKDIR /app

RUN apk add --no-cache ca-certificates \
  && addgroup -g 1001 rancherhub \
  && adduser -D -u 1001 -G rancherhub rancherhub \
  && mkdir -p /app/data \
  && chown -R rancherhub:rancherhub /app

COPY --from=builder --chown=rancherhub:rancherhub /out/rancher-hub-backend ./rancher-hub-backend

ENV GIN_MODE=release
ENV PORT=3000
ENV DATABASE_PATH=/app/data/rancher-hub.db

USER rancherhub

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/health || exit 1

CMD ["./rancher-hub-backend"]
