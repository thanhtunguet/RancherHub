{
  "name": "rancher-hub-backend",
  "version": "1.0.0",
  "description": "Go backend for Rancher Hub",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "mkdir -p dist && CGO_CFLAGS='-O0' go build -tags=nomsgpack -o dist/rancher-hub-backend ./cmd/server",
    "format": "gofmt -w cmd internal",
    "start": "go run -tags=nomsgpack ./cmd/server",
    "start:dev": "CGO_CFLAGS='-O0' go run -tags=nomsgpack ./cmd/server",
    "start:debug": "CGO_CFLAGS='-O0' go run -tags=nomsgpack ./cmd/server",
    "start:prod": "./dist/rancher-hub-backend",
    "lint": "gofmt -w cmd internal",
    "test": "CGO_CFLAGS='-O0' go test -tags=nomsgpack ./..."
  }
}
